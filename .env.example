# ── Database ──
DATABASE_URL="postgresql://vtech:vtech_dev_password@localhost:55450/warranty_app?schema=public"
# Used by `npm test` (a separate database that tests may wipe)
TEST_DATABASE_URL="postgresql://vtech:vtech_dev_password@localhost:55450/warranty_test?schema=public"
# Used by `npm run test:e2e` (Playwright; wiped and re-seeded on every run)
E2E_DATABASE_URL="postgresql://vtech:vtech_dev_password@localhost:55450/warranty_e2e?schema=public"

# ── App ──
# Public base URL printed into QR codes when a brand has no verified primary domain.
APP_URL="http://localhost:3000"
# Comma-separated hostnames allowed to call cookie-authenticated APIs (CSRF origin check).
TRUSTED_ORIGINS="http://localhost:3000"

# ── Secrets (generate with: openssl rand -base64 48) ──
AUTH_SECRET="change-me-to-a-long-random-string"
# Pepper mixed into hashed patient access codes and tokens
HASH_PEPPER="change-me-too"
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts patient phone numbers & access codes.
# Never change after go-live without re-encrypting data.
DATA_ENCRYPTION_KEY=""

# ── Session lifetimes ──
WEB_SESSION_DAYS=7
MOBILE_ACCESS_TOKEN_MINUTES=15
MOBILE_REFRESH_TOKEN_DAYS=60

# ── Uploads (claim photos) ──
# local = files under STORAGE_LOCAL_DIR; s3 = any S3-compatible service (S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
CLAIM_IMAGE_MAX_MB=8
CLAIM_IMAGE_MAX_COUNT=6

# ── Patient phone OTP ── console (prints codes to the server log; dev only) | zalo | sms | disabled
OTP_PROVIDER=console

# ── Seed (only used by `npm run db:seed`, never in production) ──
SEED_ADMIN_EMAIL="admin@vtech.local"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_LAB_PASSWORD="LabDemo!2026"

# ── Postgres container (docker-compose) ──
POSTGRES_USER=vtech
POSTGRES_PASSWORD=vtech_dev_password
POSTGRES_DB=vtech_warranty
