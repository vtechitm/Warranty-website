{
	email {$ACME_EMAIL}
	# Brand domains (warranty.origin.vn, …) get certificates on demand, but only if the
	# app confirms the hostname is a configured brand domain.
	on_demand_tls {
		ask http://app:3000/api/tls-check
	}
}

{$PRIMARY_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}
}
