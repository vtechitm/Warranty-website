# Copy to .env.production on the VPS and fill every value. Never commit the real file.

# Public platform domain (default QR base URL when a brand has no verified primary domain)
PRIMARY_DOMAIN=warranty.vtechdental.vn
APP_URL=https://warranty.vtechdental.vn
TRUSTED_ORIGINS=https://warranty.vtechdental.vn
ACME_EMAIL=it@vtechdental.vn

# Only for docker-compose.external-proxy.yml (server that already runs a reverse proxy):
# the Docker network of that proxy (docker network ls), e.g. vtech-ci_default
PROXY_NETWORK=

# PostgreSQL
POSTGRES_USER=vtech
# openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=vtech_warranty

# Secrets — generate each with: openssl rand -base64 48   (DATA_ENCRYPTION_KEY: openssl rand -base64 32)
AUTH_SECRET=
HASH_PEPPER=
DATA_ENCRYPTION_KEY=

WEB_SESSION_DAYS=7
BACKUP_KEEP_DAYS=14

# Claim photos — local (Docker volume "uploads", include it in your backups) or s3 (AWS S3, Cloudflare R2, MinIO, …)
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=vtech-warranty-claims
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
CLAIM_IMAGE_MAX_MB=8
CLAIM_IMAGE_MAX_COUNT=6

# Patient phone OTP: disabled | zalo | sms  (zalo/sms providers are stubs until implemented in src/server/otp.ts)
OTP_PROVIDER=disabled
# ZALO_ZNS_ACCESS_TOKEN=
# ZALO_ZNS_TEMPLATE_ID=
# SMS_API_URL=
# SMS_API_KEY=
# SMS_BRANDNAME=
