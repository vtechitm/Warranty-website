{
  "name": "vtech-dental-warranty",
  "version": "1.0.0",
  "private": true,
  "description": "Vtech Dental Warranty & Digital Dental Passport Platform",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@expo-google-fonts/be-vietnam-pro": "0.4.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/client": "6.19.3",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "html5-qrcode": "2.3.8",
    "jose": "6.2.12",
    "jszip": "3.10.2",
    "lucide-react": "1.58.0",
    "next": "15.5.28",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.15.30",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "unpdf": "1.9.0",
    "vitest": "3.2.7"
  }
}
